# SLM provider: "hf_transformers" (local) or "vllm" (remote/deployed).
SLM_PROVIDER=hf_transformers

# SLM model id used for single-model commands (`seh chat`, `seh detect`).
# Default = the registry's local default (Gemma 4 E2B — laptop-friendly).
# For the L4-deployed default, set to google/gemma-4-E4B-it. The evaluation
# sweep is configured separately via TARGET_MODEL_IDS.
VLLM_MODEL_ID=google/gemma-4-E2B-it

# vLLM generation endpoint (only used when SLM_PROVIDER=vllm). Acts as the
# *fallback* base URL for every model in TARGET_MODEL_IDS without a per-model
# override in TARGET_MODEL_BASE_URLS.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local-dummy

# Evaluation sweep — JSON list of SLM ids the harness iterates over. Must
# contain >=2 unique ids, all present in the model registry. Default = the
# four Gemma 4 SKUs.
TARGET_MODEL_IDS=["google/gemma-4-E2B-it","google/gemma-4-E4B-it","google/gemma-4-26B-A4B-it","google/gemma-4-31B-it"]

# Optional per-model base_url overrides for the sweep. JSON dict; keys must
# be a subset of TARGET_MODEL_IDS. Empty dict = every model uses VLLM_BASE_URL
# (sequential sweep against one reconfigured endpoint, cheap).
TARGET_MODEL_BASE_URLS={}

# Optional sibling vLLM instance launched with --task embed. When set,
# VLLMOpenAIProvider hits /v1/embeddings here to get pooled hidden states for
# SEP. Leave blank to disable SEP at the vLLM provider.
VLLM_EMBED_BASE_URL=
VLLM_EMBED_MODEL_ID=

# Google Cloud
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Judge (Vertex Gemini)
JUDGE_MODEL_ID=gemini-2.5-flash
EVAL_JUDGE_MODEL_ID=gemini-2.5-pro

# NLI for semantic clustering
NLI_MODEL_ID=microsoft/deberta-large-mnli

# Detection
SE_THRESHOLD=1.0
SAMPLE_N=10
SAMPLE_TEMPERATURE=1.0
TOP_LOGPROBS=5
MAX_TOKENS=64

# Detector dispatch — comma-separated detector names. Valid:
# predictive_entropy, semantic_entropy_probe, semantic_entropy.
# Note: semantic_entropy_probe requires VLLM_EMBED_BASE_URL configured (vLLM
# path) or SLM_PROVIDER=hf_transformers (local path).
ENABLED_DETECTORS=predictive_entropy,semantic_entropy
ESCALATION_DETECTOR=semantic_entropy
