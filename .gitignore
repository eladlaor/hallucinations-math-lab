# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv/
dist/
build/
wheels/

# Env / secrets
.env
.env.*
!.env.example
*.key
service-account*.json
credentials*.json

# Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hf_cache/
hf_cache/

# Data and results
data/
eval/results/
*.parquet
*.arrow

# Logs
*.log
logs/

# Model weights (do not commit; use HF Hub)
*.safetensors
*.bin
*.pt
*.ckpt
weights/
checkpoints/

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Terraform: local state, plan files, downloaded providers. The
# *.auto.tfvars.json file generated from the model registry IS committed
# (it's a derived artifact of demo/model_registry.py, not a per-user setting).
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.*
terraform/*.tfvars
!terraform/*.auto.tfvars.json
!terraform/terraform.tfvars.example
terraform/*.tfplan


# Private material: kept on disk, never published.
.claude/
knowledge/lectures/
knowledge/submissions/
